  <data key="d5">1794272681</data>
  <data key="d6"></data>
</node>
<node id="Menteri">
  <data key="d0">Menteri</data>
  <data key="d1">pihak</data>
  <data key="d2">Pejabat pemerintah yang berwenang menetapkan kebijakan pengelolaan perikanan.&lt;SEP&gt;Menteri yang membidangi urusan perikanan.&lt;SEP&gt;Pejabat yang berwenang menetapkan jenis ikan dilindungi, kawasan konservasi, dan jumlah tangkapan.&lt;SEP&gt;Pejabat yang berwenang menetapkan rencana induk dan standar teknis pelabuhan perikanan.&lt;SEP&gt;Pejabat pemerintah yang berwenang mengoordinasikan pengusulan syahbandar.</data>
  <data key="d3">doc-7f186dc1dbe4f96171df8c5ddd35e78c-chunk-000&lt;SEP&gt;doc-43df10e6e9d0084e37aaaa12389c3594-chunk-000&lt;SEP&gt;doc-d4efaf2ccfb9148966f567b761f9e636-chunk-000&lt;SEP&gt;doc-da27389e26574b8d11abcc89be16cb80-chunk-000&lt;SEP&gt;doc-cf9c7900d4ef765391a93f082f8d9802-chunk-000&lt;SEP&gt;doc-d83b1d37e67f4630f71d86ab0bd3b1f9-chunk-000</data>
