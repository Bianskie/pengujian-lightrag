<node id="Pembudidayaan ikan">
  <data key="d0">Pembudidayaan ikan</data>
  <data key="d1">konsep</data>
  <data key="d2">Kegiatan memelihara, membesarkan, membiakkan, dan memanen ikan dalam lingkungan terkontrol, termasuk kegiatan logistik kapal.</data>
  <data key="d3">doc-90fc68391bdbe262032be87173756e8b-chunk-000</data>
