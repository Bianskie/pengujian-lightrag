<node id="Sumber Daya Ikan">
  <data key="d0">Sumber Daya Ikan</data>
  <data key="d1">konsep</data>
  <data key="d2">Potensi ikan di perairan kedaulatan NKRI, ZEEI, dan laut lepas.&lt;SEP&gt;Potensi perikanan yang menjadi objek pengelolaan dan pelestarian.</data>
  <data key="d3">doc-44ccedc170cf485e59949bf246c685e9-chunk-000&lt;SEP&gt;doc-06cd586857bf10231b941904022e0250-chunk-000</data>
