    <edge source="Penyidik" target="Tindak Pidana di Bidang Perikanan">
      <data key="d7">3.0</data>
      <data key="d8">The investigator is authorized to handle crimes in the fisheries sector.&lt;SEP&gt;The Penyidik conducts a formal investigation into crimes in the fishery sector.&lt;SEP&gt;The investigator is responsible for identifying and investigating crimes in the fisheries sector.</data>
      <data key="d9">Authority,Investigates,Investigation</data>
      <data key="d10">doc-8770027e15cde832da62e2b93ca6687a-chunk-000&lt;SEP&gt;doc-e111b20ee7a6e5dcbfece2d804a2075a-chunk-000&lt;SEP&gt;doc-7aded5d5e52a1e434667c92c52046b41-chunk-000</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1793623421</data>
      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Saksi">
      <data key="d7">1.0</data>
      <data key="d8">The investigator can summon and examine witnesses.</data>
      <data key="d9">Examine,Summon</data>
      <data key="d10">doc-8770027e15cde832da62e2b93ca6687a-chunk-000</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1793617642</data>
      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Tersangka">
      <data key="d7">2.0</data>
      <data key="d8">The investigator can summon, examine, and bring suspects.&lt;SEP&gt;The Penyidik holds the Tersangka in custody and must release them once the time limit is reached or investigation needs are met.</data>
      <data key="d9">Bring,Detains,Examine,Releases,Summon</data>
      <data key="d10">doc-8770027e15cde832da62e2b93ca6687a-chunk-000&lt;SEP&gt;doc-e111b20ee7a6e5dcbfece2d804a2075a-chunk-000</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1793617702</data>
      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Kapal">
      <data key="d7">1.0</data>
      <data key="d8">The investigator can stop, inspect, and detain ships suspected of crimes.</data>
      <data key="d9">Detain,Inspect,Stop</data>
      <data key="d10">doc-8770027e15cde832da62e2b93ca6687a-chunk-000</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1793617642</data>
      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Ahli">
      <data key="d7">1.0</data>
      <data key="d8">The investigator can bring in experts related to the crime.</data>
      <data key="d9">Bring</data>
      <data key="d10">doc-8770027e15cde832da62e2b93ca6687a-chunk-000</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1793617642</data>
      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Dokumen Usaha Perikanan">
      <data key="d7">1.0</data>
      <data key="d8">The investigator can check the completeness and validity of fisheries business documents.</data>
      <data key="d9">Examine</data>
      <data key="d10">doc-8770027e15cde832da62e2b93ca6687a-chunk-000</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1793617642</data>
      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Barang Bukti">
      <data key="d7">1.0</data>
      <data key="d8">The investigator can seize and photograph evidence.</data>
      <data key="d9">Photograph,Seize</data>
