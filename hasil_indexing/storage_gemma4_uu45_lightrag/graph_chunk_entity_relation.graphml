    <edge source="Kapal Penangkap Ikan" target="Wilayah Pengelolaan Perikanan">
      <data key="d7">1.0</data>
      <data key="d8">Fishing vessels are used to conduct fishing in the fishing management area.</data>
      <data key="d9">operates in</data>
      <data key="d10">doc-75e0a9225f4cfb6419813f0b2ea4b76d-chunk-000</data>
