    <node id="Zona Ekonomi Eksklusif Indonesia (ZEEI)">
      <data key="d0">Zona Ekonomi Eksklusif Indonesia (ZEEI)</data>
      <data key="d1">location</data>
      <data key="d2">A route outside and bordering the Indonesian territorial sea, including the seabed, land beneath it, and water above it, with an outer limit of 200 nautical miles measured from the baseline of the Indonesian territorial sea.</data>
      <data key="d3">doc-3f250dcbafd593c2d06ce016eeea9d5f-chunk-000</data>
