      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Penghentian Penyidikan">
      <data key="d7">1.0</data>
      <data key="d8">The investigator is authorized to perform a suspension of an investigation.</data>
      <data key="d9">Execute,Perform</data>
