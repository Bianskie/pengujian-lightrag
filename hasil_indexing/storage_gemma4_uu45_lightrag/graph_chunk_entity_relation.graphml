    </node>
    <node id="Pengelolaan Perikanan">
      <data key="d0">Pengelolaan Perikanan</data>
      <data key="d1">method</data>
      <data key="d2">The procedures and workflows for managing and supervising the fisheries sector.&lt;SEP&gt;All efforts, including integrated processes in information collection, analysis, planning, consultation, decision making, fish resource allocation, and implementation and law enforcement of regulations in the fisheries field, conducted by the government or other authorities.&lt;SEP&gt;The management of fishery activities encompassing port operations, conservation, licensing, and port authority.&lt;SEP&gt;The systematic management of fishery resources based on various principles and approaches.</data>
      <data key="d3">doc-cc580ed1c232b689fe641ba4c1dc39ca-chunk-000&lt;SEP&gt;doc-3f250dcbafd593c2d06ce016eeea9d5f-chunk-000&lt;SEP&gt;doc-7c49841464685c342625bf812725d84b-chunk-001&lt;SEP&gt;doc-9b360d50b06bd57b4cb7c6ddbce56066-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1793620707</data>
      <data key="d6" />
    </node>
    <node id="Teknologi">
      <data key="d0">Teknologi</data>
      <data key="d1">concept</data>
      <data key="d2">Technological developments that the fisheries laws must anticipate.</data>
      <data key="d3">doc-cc580ed1c232b689fe641ba4c1dc39ca-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1793611602</data>
