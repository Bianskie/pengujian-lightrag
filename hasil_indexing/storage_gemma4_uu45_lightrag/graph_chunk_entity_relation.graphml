    <edge source="UU Nomor 45 Tahun 2009" target="Presiden Republik Indonesia">
      <data key="d7">3.0</data>
      <data key="d8">Presiden Republik Indonesia enacts UU Nomor 45 Tahun 2009.&lt;SEP&gt;The President provided approval for the enactment of the law.&lt;SEP&gt;The President approved the law on October 29, 2009.</data>
      <data key="d9">Approval,Enacts,Establishes,Establishment,Signing</data>
      <data key="d10">doc-cc580ed1c232b689fe641ba4c1dc39ca-chunk-000&lt;SEP&gt;doc-c368c83da785235c86f2546f89c595c3-chunk-000&lt;SEP&gt;doc-8f43260542e30c39011c792f39a1f499-chunk-000</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1793620006</data>
      <data key="d13" />
    </edge>
    <edge source="UU Nomor 45 Tahun 2009" target="Undang-Undang Nomor 31 Tahun 2004 Tentang Perikanan">
      <data key="d7">1.0</data>
      <data key="d8">UU Nomor 45 Tahun 2009 serves as an amendment to the 2004 fisheries law.</data>
      <data key="d9">Amendment,Change</data>
      <data key="d10">doc-c368c83da785235c86f2546f89c595c3-chunk-000</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1793611644</data>
      <data key="d13" />
    </edge>
    <edge source="UU Nomor 45 Tahun 2009" target="Undang-Undang Dasar Negara Republik Indonesia Tahun 1945">
      <data key="d7">1.0</data>
      <data key="d8">This law references the 1945 Constitution.</data>
      <data key="d9">Compliance,Reference</data>
      <data key="d10">doc-c368c83da785235c86f2546f89c595c3-chunk-000</data>
      <data key="d11">unknown_source</data>
