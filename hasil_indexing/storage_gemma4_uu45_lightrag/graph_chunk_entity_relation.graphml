    <node id="Sistem Penegakan Hukum">
      <data key="d0">Sistem Penegakan Hukum</data>
      <data key="d1">method</data>
      <data key="d2">The legal enforcement system designed to oversee and manage the exploitation of fish resources.</data>
      <data key="d3">doc-cc580ed1c232b689fe641ba4c1dc39ca-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1793611602</data>
