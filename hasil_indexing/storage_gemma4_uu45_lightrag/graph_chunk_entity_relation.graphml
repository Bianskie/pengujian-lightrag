    <node id="Lahan Pembudidayaan Ikan">
      <data key="d0">Lahan Pembudidayaan Ikan</data>
      <data key="d1">location</data>
      <data key="d2">Aquaculture land that serves as a potential resource for fish farming in Indonesian waters.&lt;SEP&gt;Specific areas designated for fish farming and cultivation.&lt;SEP&gt;The physical land area designated and utilized for fish farming.</data>
      <data key="d3">doc-cc580ed1c232b689fe641ba4c1dc39ca-chunk-000&lt;SEP&gt;doc-1ffff1f2e3dfa130e836c0fbbe361e57-chunk-000&lt;SEP&gt;doc-ca77871eaf5880d4a99669013079d4d5-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1793613015</data>
