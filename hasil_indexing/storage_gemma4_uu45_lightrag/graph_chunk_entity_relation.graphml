    <edge source="Sumber Daya Ikan" target="Konservasi Sumber Daya Ikan">
      <data key="d7">1.0</data>
      <data key="d8">Fish resource conservation is an effort to protect, preserve, and utilize fish resources.</data>
      <data key="d9">preserves,protects</data>
