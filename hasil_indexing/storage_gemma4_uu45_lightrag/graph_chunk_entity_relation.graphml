      <data key="d8">UU Nomor 45 Tahun 2009 amends Undang-Undang Nomor 31 Tahun 2004.</data>
      <data key="d9">Amends,Modifies</data>
      <data key="d10">doc-cc580ed1c232b689fe641ba4c1dc39ca-chunk-000</data>
