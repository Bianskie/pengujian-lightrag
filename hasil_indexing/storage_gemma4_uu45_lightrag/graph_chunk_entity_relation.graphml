  <data key="d5">1794273898</data>
  <data key="d6"></data>
</node>
<node id="Korporasi">
  <data key="d0">Korporasi</data>
  <data key="d1">pihak</data>
  <data key="d2">Kumpulan orang dan/atau kekayaan yang terorganisasi, baik badan hukum maupun bukan badan hukum.</data>
  <data key="d3">doc-c772972bd888057dab1754dcfb2e8222-chunk-000</data>
  <data key="d4">UU_45_2009_MinerU.md#chunk-0004 (Pasal 1)</data>
