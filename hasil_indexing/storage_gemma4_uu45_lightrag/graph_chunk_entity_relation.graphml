      <data key="d12">1793613833</data>
      <data key="d13" />
    </edge>
    <edge source="Kapal Penangkap Ikan" target="ZEEI">
      <data key="d7">2.0</data>
      <data key="d8">Foreign-flagged fishing vessels must have a SIPI to operate in the ZEEI.&lt;SEP&gt;A Kapal Penangkap Ikan may operate within the Indonesian Exclusive Economic Zone.</data>
      <data key="d9">operates in</data>
      <data key="d10">doc-75e0a9225f4cfb6419813f0b2ea4b76d-chunk-000&lt;SEP&gt;doc-5b92e3da08870a168c229ea3603a9355-chunk-000</data>
