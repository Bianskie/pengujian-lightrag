      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Sarana dan Prasarana Perikanan">
      <data key="d7">1.0</data>
      <data key="d8">The investigator is authorized to search fisheries facilities and infrastructure suspected of being used in crimes.</data>
      <data key="d9">Inspect,Search</data>
      <data key="d10">doc-8770027e15cde832da62e2b93ca6687a-chunk-000</data>
      <data key="d11">unknown_source</data>
