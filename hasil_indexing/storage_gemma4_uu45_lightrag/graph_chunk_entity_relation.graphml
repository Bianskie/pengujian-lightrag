    <node id="Fish Resources">
      <data key="d0">Fish Resources</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Potential fish resources and aquaculture land found in Indonesian waters, the Exclusive Economic Zone, and the high seas.&lt;SEP&gt;Biological resources consisting of fish and related marine life.&lt;SEP&gt;The aquatic resources whose sustainability is protected by Indonesian law.</data>
