      <data key="d13" />
    </edge>
    <edge source="Penyidik" target="Berita Acara Pemeriksaan">
      <data key="d7">1.0</data>
      <data key="d8">The investigator can create and sign examination reports.</data>
      <data key="d9">Create,Sign</data>
