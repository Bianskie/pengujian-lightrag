    <node id="Undang-Undang Nomor 31 Tahun 2004">
      <data key="d0">Undang-Undang Nomor 31 Tahun 2004</data>
      <data key="d1">content</data>
      <data key="d2">A law regarding fisheries in Indonesia that is amended by UU Nomor 45 Tahun 2009.&lt;SEP&gt;A law concerning fisheries intended to anticipate changes in fish resource availability, environmental sustainability, and modern management methods.</data>
      <data key="d3">doc-cc580ed1c232b689fe641ba4c1dc39ca-chunk-000&lt;SEP&gt;doc-7c49841464685c342625bf812725d84b-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1793620284</data>
      <data key="d6" />
    </node>
