  <data key="d0">Presiden Republik Indonesia</data>
  <data key="d1">pihak</data>
  <data key="d2">Kepala Negara yang mengesahkan Undang-Undang.&lt;SEP&gt;Kepala Negara yang mengesahkan undang-undang.</data>
